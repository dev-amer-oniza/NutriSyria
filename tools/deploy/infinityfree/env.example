# Copy to .env (in htdocs/core) and fill the blanks.
APP_NAME=NutriSyria
APP_ENV=production
# Same APP_KEY as your local .env: health data and login codes are encrypted with it.
APP_KEY=
APP_DEBUG=false
APP_URL=http://nutrisyria.rf.gd

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=single
LOG_LEVEL=error

# From InfinityFree: Control Panel > MySQL Databases.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
# No queue worker on shared hosting.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Login codes. "log" writes them to core/storage/logs/laravel.log;
# for real emails use your Gmail app password:
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SCHEME=null
#   MAIL_USERNAME=you@gmail.com  MAIL_PASSWORD=<app password>
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@nutrisyria.rf.gd"
MAIL_FROM_NAME="NutriSyria"

# Optional. Add http://nutrisyria.rf.gd/auth/google/callback in Google Cloud first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=central
