# NutriSyria on one small server (see docs/DEPLOY.md). Copy to .env on the server and fill
# the blanks. Secrets (passwords, keys) live in that .env only, never in git.

APP_NAME=NutriSyria
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nutrisyria.example

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# One daily file, kept 14 days; only warnings and errors.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nutrisyria
DB_USERNAME=nutrisyria
DB_PASSWORD=

# Sessions stay in the database: "change password" signs the other devices out through them.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# The cache on disk: no Redis needed on one server, and it keeps load off MySQL.
CACHE_STORE=file

# Nothing is queued: mail (sign-in codes) is sent at once, so no worker process is needed.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Optional services. A blank key hides what needs it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
FDC_API_KEY=

VITE_APP_NAME="${APP_NAME}"
