# Static analysis (Larastan). Level 5 for the whole app; the baseline holds what was found
# when it was introduced, so CI fails only on new mistakes. Shrink the baseline over time.
includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
        - config
        - database
        - routes
    tmpDir: storage/framework/cache/phpstan
    # The baseline is a ceiling: a fixed entry must not fail the build.
    reportUnmatchedIgnoredErrors: false
